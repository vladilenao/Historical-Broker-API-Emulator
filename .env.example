# Токен брокера нужен для самостоятельной загрузки истории и карточек инструментов.
TINKOFF_TOKEN=

HISTORICAL_BROKER_HOST=127.0.0.1
HISTORICAL_BROKER_PORT=8100
HISTORICAL_BROKER_LOG_LEVEL=INFO

# Экспортный сервер My Robot обычно слушает loopback на порту 8101.
HISTORICAL_BROKER_IMPORT_ENABLED=false
HISTORICAL_BROKER_IMPORT_URL=http://127.0.0.1:8101
HISTORICAL_BROKER_IMPORT_TOKEN=
HISTORICAL_BROKER_IMPORT_CONSUMER_ID=historical-emulator
HISTORICAL_BROKER_IMPORT_POLL_SECONDS=60
HISTORICAL_BROKER_IMPORT_TIMEOUT_SECONDS=10
