+def test_historical_provider_uses_one_preflight_snapshot_for_candle_pages():
+    calls = []
+
+    def respond(url, timeout=None):
+        calls.append(url)
+        if hasattr(url, "get_method"):
+            assert url.get_method() == "POST"
+            assert url.full_url.endswith("/api/v1/market-import/sync")
+            return _Response({
+                "synchronized": True, "snapshot_generation": 7,
+                "after_id": 12,
+            })
+        return _Response({"candles": [], "total": 0, "next_cursor": None})
+
+    with patch("src.api.emulator_client.request.urlopen", respond):
+        provider = EmulatorClientProvider("http://emulator:8100")
+        assert provider.prepare_snapshot()["snapshot_generation"] == 7
+        list(provider.client_context().get_all_candles(
+            from_=datetime(2024, 1, 1, tzinfo=timezone.utc),
+            interval=CandleInterval.CANDLE_INTERVAL_1_MIN,
+            instrument_id="uid-1",
+        ))
+
+    assert len(calls) == 2
+    assert "snapshot_generation=7" in calls[1]
